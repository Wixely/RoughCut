{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ RoughCut",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Desktop/bin/Debug/net10.0/roughcut-desktop.dll",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "presentation": { "group": "1: App", "order": 1 }
    },
    {
      "name": "RoughCut desktop: open a project",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Desktop/bin/Debug/net10.0/roughcut-desktop.dll",
      "args": [
        "review",
        "${input:projectPath}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "1: App", "order": 2 }
    },
    {
      "name": "RoughCut desktop: open a project with a pre-rendered preview",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Desktop/bin/Debug/net10.0/roughcut-desktop.dll",
      "args": [
        "review",
        "${input:projectPath}",
        "${input:reviewProxyPath}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "1: App", "order": 3 }
    },
    {
      "name": "RoughCut contract checks",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tests/RoughCut.Tests/bin/Debug/net10.0/RoughCut.Tests.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "2: Checks", "order": 1 }
    },
    {
      "name": "RoughCut: media, CLI, desktop and MCP checks",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/tests/RoughCut.Tests/bin/Debug/net10.0/RoughCut.Tests.dll",
      "args": [
        "--media",
        "--cli",
        "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
        "--desktop",
        "${workspaceFolder}/src/RoughCut.Desktop/bin/Debug/net10.0/roughcut-desktop.dll",
        "--mcp",
        "${workspaceFolder}/src/RoughCut.Mcp/bin/Debug/net10.0/roughcut-mcp.dll"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "2: Checks", "order": 2 }
    },
    {
      "name": "RoughCut: acquire URL",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "acquire",
        "${input:sourceUrl}",
        "${input:acquisitionDirectory}",
        "${input:denoPath}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "3: Acquire and transcribe", "order": 1 }
    },
    {
      "name": "RoughCut: assess caption candidates",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "captions-select",
        "${input:projectPath}",
        "${input:assetId}",
        "${input:captionCandidatesPath}",
        "${input:expectedRevision}",
        "${input:preferredLanguage}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "3: Acquire and transcribe", "order": 2 }
    },
    {
      "name": "RoughCut: import SRT captions",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "captions",
        "${input:projectPath}",
        "${input:assetId}",
        "${input:captionPath}",
        "${input:expectedRevision}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "3: Acquire and transcribe", "order": 3 }
    },
    {
      "name": "RoughCut: prepare Whisper model",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Speech.Cli/bin/Debug/net10.0/roughcut-speech.dll",
      "args": [
        "model",
        "${input:whisperModelPath}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "3: Acquire and transcribe", "order": 4 }
    },
    {
      "name": "RoughCut: transcribe locally",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Speech.Cli/bin/Debug/net10.0/roughcut-speech.dll",
      "args": [
        "transcribe",
        "${input:projectPath}",
        "${input:assetId}",
        "${input:expectedRevision}",
        "${input:whisperModelPath}",
        "${input:transcriptionLanguage}",
        "${input:transcriptionChunkSeconds}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "3: Acquire and transcribe", "order": 5 }
    },
    {
      "name": "RoughCut: save analysis proposals",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "analyse",
        "${input:projectPath}",
        "${input:analysisSubmissionPath}",
        "${input:expectedRevision}",
        "${input:analysisPolicy}",
        "${input:analysisPrompt}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "4: Analyse", "order": 1 }
    },
    {
      "name": "RoughCut: apply automatic analysis decisions",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "analysis-apply",
        "${input:projectPath}",
        "${input:expectedRevision}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "4: Analyse", "order": 2 }
    },
    {
      "name": "RoughCut: edit speakers",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": ["speaker-edit", "${input:projectPath}", "${input:speakerEditsPath}", "${input:expectedRevision}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "5: Speakers and voice", "order": 1 }
    },
    {
      "name": "RoughCut: save diarization",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": ["diarization-save", "${input:projectPath}", "${input:diarizationSubmissionPath}", "${input:expectedRevision}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "5: Speakers and voice", "order": 2 }
    },
    {
      "name": "RoughCut: diarize locally with Sherpa",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Diarization.Cli/bin/Debug/net10.0/roughcut-diarization.dll",
      "args": [
        "diarize",
        "${input:projectPath}",
        "${input:assetId}",
        "${input:expectedRevision}",
        "${input:diarizationSegmentationModel}",
        "${input:diarizationEmbeddingModel}",
        "${input:diarizationSpeakerCount}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "5: Speakers and voice", "order": 3 }
    },
    {
      "name": "RoughCut: plan voice replacement",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": ["voice-plan", "${input:projectPath}", "${input:voicePlanPath}", "${input:expectedRevision}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "5: Speakers and voice", "order": 4 }
    },
    {
      "name": "RoughCut: synthesize voice with Qwen",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": ["voice-synthesize", "${input:projectPath}", "${input:expectedRevision}", "${input:replacementId}"],
      "env": { "ROUGHCUT_QWEN_ENDPOINT": "${input:qwenEndpoint}" },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "5: Speakers and voice", "order": 5 }
    },
    {
      "name": "RoughCut: import voice preview",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": ["voice-preview-import", "${input:projectPath}", "${input:replacementId}", "${input:voicePreviewPath}", "${input:expectedRevision}", "${input:qwenRuntime}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "5: Speakers and voice", "order": 6 }
    },
    {
      "name": "RoughCut: get voice preview",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": ["voice-preview", "${input:projectPath}", "${input:expectedRevision}", "${input:replacementId}", "${input:voicePreviewOutput}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "5: Speakers and voice", "order": 7 }
    },
    {
      "name": "RoughCut: apply voice preview",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": ["voice-state", "${input:projectPath}", "${input:expectedRevision}", "${input:replacementId}", "applied"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "5: Speakers and voice", "order": 8 }
    },
    {
      "name": "RoughCut: create project",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "create",
        "${input:videoPath}",
        "${input:newProjectPath}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "6: Edit and export", "order": 1 }
    },
    {
      "name": "RoughCut: apply edit operations",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "edit",
        "${input:projectPath}",
        "${input:operationsPath}",
        "${input:expectedRevision}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "6: Edit and export", "order": 2 }
    },
    {
      "name": "RoughCut: extract frame",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "frame",
        "${input:videoPath}",
        "${input:timestamp}",
        "${input:frameOutput}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "6: Edit and export", "order": 3 }
    },
    {
      "name": "RoughCut: preview timeline frame",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "timeline-frame",
        "${input:projectPath}",
        "${input:expectedRevision}",
        "${input:timestamp}",
        "${input:timelineFrameOutput}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "6: Edit and export", "order": 4 }
    },
    {
      "name": "RoughCut: preflight export",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "preflight",
        "${input:projectPath}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "6: Edit and export", "order": 5 }
    },
    {
      "name": "RoughCut: export without encoding",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "export",
        "${input:projectPath}",
        "${input:exportDirectory}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "6: Edit and export", "order": 6 }
    },
    {
      "name": "RoughCut: export allowing encoding",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "export",
        "${input:projectPath}",
        "${input:exportDirectory}",
        "--allow-encode"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "6: Edit and export", "order": 7 }
    },
    {
      "name": "RoughCut MCP (stdio)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Mcp/bin/Debug/net10.0/roughcut-mcp.dll",
      "args": [
        "--workspace",
        "${input:mcpWorkspace}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "7: Hosts", "order": 1 }
    },
    {
      "name": "RoughCut CLI help",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RoughCut.Cli/bin/Debug/net10.0/roughcut.dll",
      "args": [
        "help"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "presentation": { "group": "7: Hosts", "order": 2 }
    }
  ],
  "inputs": [
    {
      "id": "mcpWorkspace",
      "type": "promptString",
      "description": "Workspace root exposed to the stdio MCP server",
      "default": "${workspaceFolder}/artifacts/mcp-workspace"
    },
    {
      "id": "videoPath",
      "type": "promptString",
      "description": "Local video path (absolute or relative to workspace; no surrounding quotes)",
      "default": "artifacts/demo/media/source.mkv"
    },
    {
      "id": "timestamp",
      "type": "promptString",
      "description": "Source-relative timestamp in seconds (up to six decimal places)",
      "default": "0.35"
    },
    {
      "id": "frameOutput",
      "type": "promptString",
      "description": "New PNG output path (must not already exist)",
      "default": "artifacts/demo/frame.png"
    },
    {
      "id": "timelineFrameOutput",
      "type": "promptString",
      "description": "New rendered timeline PNG path (must not already exist)",
      "default": "artifacts/demo/timeline-frame.png"
    },
    {
      "id": "newProjectPath",
      "type": "promptString",
      "description": "New project JSON path (must not exist; video must be inside its directory)",
      "default": "artifacts/demo/project.json"
    },
    {
      "id": "projectPath",
      "type": "promptString",
      "description": "Existing project JSON path",
      "default": "artifacts/demo/project.json"
    },
    {
      "id": "reviewProxyPath",
      "type": "promptString",
      "description": "Pre-rendered WebM review proxy (not a validated RoughCut export)",
      "default": "artifacts/demo/review.webm"
    },
    {
      "id": "expectedRevision",
      "type": "promptString",
      "description": "Current destination revision before saving",
      "default": "1"
    },
    {
      "id": "operationsPath",
      "type": "promptString",
      "description": "Edit operation array JSON (times in project ticks)",
      "default": "examples/cut-and-reorder.json"
    },
    {
      "id": "assetId",
      "type": "promptString",
      "description": "Video asset ID to attach captions to",
      "default": "source-1"
    },
    {
      "id": "captionPath",
      "type": "promptString",
      "description": "UTF-8 SRT file inside the project directory",
      "default": "artifacts/demo/source.srt"
    },
    {
      "id": "captionCandidatesPath",
      "type": "promptString",
      "description": "Caption candidate array JSON",
      "default": "examples/caption-candidates.json"
    },
    {
      "id": "preferredLanguage",
      "type": "promptString",
      "description": "Preferred caption language tag",
      "default": "en"
    },
    {
      "id": "sourceUrl",
      "type": "promptString",
      "description": "HTTP(S) video URL",
      "default": "https://example.com/video"
    },
    {
      "id": "acquisitionDirectory",
      "type": "promptString",
      "description": "New acquisition directory",
      "default": "artifacts/acquired/video"
    },
    {
      "id": "denoPath",
      "type": "promptString",
      "description": "Deno executable used by yt-dlp for extractor JavaScript",
      "default": "artifacts/tools/deno-v2.9.7/deno.exe"
    },
    {
      "id": "whisperModelPath",
      "type": "promptString",
      "description": "Pinned Whisper base.en model path",
      "default": "artifacts/models/ggml-base.en.bin"
    },
    {
      "id": "transcriptionLanguage",
      "type": "promptString",
      "description": "Whisper language code",
      "default": "en"
    },
    {
      "id": "transcriptionChunkSeconds",
      "type": "promptString",
      "description": "Bounded transcription chunk size (5-30 seconds)",
      "default": "30"
    },
    {
      "id": "analysisSubmissionPath",
      "type": "promptString",
      "description": "Provider-neutral evidence and observation JSON",
      "default": "examples/analysis-submission.json"
    },
    {
      "id": "analysisPolicy",
      "type": "pickString",
      "description": "Editorial decision policy",
      "options": ["review", "auto-high-certainty"],
      "default": "review"
    },
    {
      "id": "analysisPrompt",
      "type": "promptString",
      "description": "Editorial request",
      "default": "Remove advertisements"
    },
    {
      "id": "exportDirectory",
      "type": "promptString",
      "description": "New export directory (must not already exist)",
      "default": "artifacts/demo/export"
    },
    {
      "id": "speakerEditsPath",
      "type": "promptString",
      "description": "Speaker edit batch JSON",
      "default": "examples/speaker-edits.json"
    },
    {
      "id": "diarizationSubmissionPath",
      "type": "promptString",
      "description": "Provider-neutral diarization turn JSON",
      "default": "examples/diarization-submission.json"
    },
    {
      "id": "diarizationSegmentationModel",
      "type": "promptString",
      "description": "Absolute path to the sherpa-onnx Pyannote segmentation model",
      "default": "${workspaceFolder}/artifacts/sherpa-diarization/sherpa-onnx-pyannote-segmentation-3-0/model.int8.onnx"
    },
    {
      "id": "diarizationEmbeddingModel",
      "type": "promptString",
      "description": "Absolute path to the sherpa-onnx 3D-Speaker embedding model",
      "default": "${workspaceFolder}/artifacts/sherpa-diarization/3dspeaker_speech_eres2net_base_sv_zh-cn_3dspeaker_16k.onnx"
    },
    {
      "id": "diarizationSpeakerCount",
      "type": "promptString",
      "description": "Known speaker count; use 0 for threshold clustering",
      "default": "2"
    },
    {
      "id": "voicePlanPath",
      "type": "promptString",
      "description": "Qwen voice mapping and replacement request JSON",
      "default": "examples/voice-plan.json"
    },
    {
      "id": "replacementId",
      "type": "promptString",
      "description": "Voice replacement ID",
      "default": "replacement-1"
    },
    {
      "id": "voicePreviewPath",
      "type": "promptString",
      "description": "Generated PCM WAVE preview to import",
      "default": "artifacts/demo/qwen-preview.wav"
    },
    {
      "id": "voicePreviewOutput",
      "type": "promptString",
      "description": "New WAVE output path for preview",
      "default": "artifacts/demo/voice-preview.wav"
    },
    {
      "id": "qwenRuntime",
      "type": "promptString",
      "description": "Exact Qwen runtime and version that generated the WAVE",
      "default": "faster-qwen3-tts@0.2.6"
    },
    {
      "id": "qwenEndpoint",
      "type": "promptString",
      "description": "Loopback URL for the local WSL Qwen service",
      "default": "http://127.0.0.1:8080/"
    }
  ]
}
