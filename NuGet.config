<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Named to match the source in the developer's user-level NuGet.Config so its stored credentials
         apply here; CI injects credentials for the same name. Never commit a token. -->
    <add key="GitHub-Wixely-Packages" value="https://nuget.pkg.github.com/Wixely/index.json" protocolVersion="3" />
  </packageSources>
  <!-- The MCP server's shared host and the CupriFace UI packages come from the authenticated feed;
       neither is published to nuget.org. Everything else resolves from nuget.org. Building the
       libraries and the command line needs no token; the MCP host and the desktop window do. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GitHub-Wixely-Packages">
      <package pattern="DnaX.*" />
      <package pattern="CupriFace*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
