<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Named to match the source in the developer's user-level NuGet.Config so its stored credentials
         apply here; CI injects credentials for the same name. Never commit a token. -->
    <add key="GitHub-Wixely-Packages" value="https://nuget.pkg.github.com/Wixely/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Only the MCP server's shared host comes from the authenticated feed. Everything else resolves from
       nuget.org, so a contributor without feed credentials can still restore and build the libraries, the
       command line and the desktop window - only the MCP host needs the token. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="GitHub-Wixely-Packages">
      <package pattern="DnaX.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
